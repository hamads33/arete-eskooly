<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system certificate authorities only. No trust-all, no pinning bypass. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

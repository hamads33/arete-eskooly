<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: allows plain HTTP (e.g. http://192.168.1.10:8000 on a LAN dev server and the
  Metro bundler) and user-installed CAs for a local test certificate. Never merged into release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

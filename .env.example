APP_NAME="Greenfield Institute Admin"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8081
APP_KEY=replace-with-at-least-32-random-bytes
SESSION_NAME=greenfield_admin_session
SESSION_SECURE=false
PWA_ENABLED=true

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=school_app
DB_USERNAME=school_app
DB_PASSWORD=change-this-local-password

# Google Meet live classes. Create OAuth 2.0 Web Application credentials in Google Cloud with the
# Calendar API enabled, then paste them here — never into an admin-editable database field, and
# never into a committed file. See docs/GOOGLE-MEET-INTEGRATION.md for the full setup.
# GOOGLE_REDIRECT_URI must match the authorised redirect URI on the credential exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8081/admin/integrations/google/callback
GOOGLE_CALENDAR_ID=primary
# Minutes before the scheduled start that a student's Join button becomes active.
JOIN_BEFORE_START_MINUTES=10

# Local seed only. Change these values before running `php database/seed.php`.
DEV_ADMIN_NAME="Local Administrator"
DEV_ADMIN_EMAIL=admin@greenfield.local
DEV_ADMIN_PASSWORD=
